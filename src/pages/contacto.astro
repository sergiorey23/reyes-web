---
import Layout from "../layouts/Layout.astro";
import Turnstile from "../components/Turnstile.astro";
---

<Layout title="Contacto - Reyes García Miró">
  <section class="py-12 relative bg-[url('/bg-fresh-air.webp')] bg-contain bg-center bg-no-repeat">
    <div class="absolute inset-0 bg-white/60 dark:bg-gray-800/55 backdrop-blur-sm"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
      <div class="text-center mb-12 animate-fade-in-up">
        <h1 class="text-4xl font-serif text-brand-blue-dark dark:text-brand-blue-light mb-4">Contacto</h1>
        <p class="text-xl text-gray-800 dark:text-gray-200">¿Tienes alguna duda o quieres concertar una cita? Escríbeme y te responderé lo antes posible.</p>
      </div>

      <div
        class="bg-white dark:bg-gray-800 p-6 md:p-12 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 animate-fade-in-up delay-100 relative"
      >
        <form action="/api/contact" method="POST" id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nombre *</label>
              <input
                id="name"
                type="text"
                name="name"
                autocomplete="name"
                required
                class="w-full border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-3 border focus:ring-brand-blue focus:border-brand-blue"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Teléfono</label>
              <input
                id="phone"
                type="tel"
                name="phone"
                autocomplete="tel"
                class="w-full border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-3 border focus:ring-brand-blue focus:border-brand-blue"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email *</label>
            <input
              id="email"
              type="email"
              name="email"
              autocomplete="email"
              required
              class="w-full border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-3 border focus:ring-brand-blue focus:border-brand-blue"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Comentario / Motivo de consulta *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-3 border focus:ring-brand-blue focus:border-brand-blue"></textarea>
          </div>

          <div class="flex items-start">
            <input
              type="checkbox"
              id="legal"
              name="legal"
              required
              class="mt-1 h-4 w-4 text-brand-green rounded border-gray-300 dark:border-gray-600 focus:ring-brand-green"
            />
            <label for="legal" class="ml-2 block text-sm text-gray-600 dark:text-gray-400">
              He leído y acepto la <a href="/politica-privacidad" class="text-brand-blue-dark dark:text-brand-blue-light underline">política de privacidad</a> y las
              <a href="/aviso-legal" class="text-brand-blue-dark dark:text-brand-blue-light underline">condiciones legales</a>.
            </label>
          </div>

          <Turnstile />

          <div id="contact-error" class="hidden p-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-700 dark:text-red-300"></div>

          <div>
            <button
              type="submit"
              id="contact-submit-btn"
              class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-md shadow-sm text-lg font-medium text-white bg-amber-500 dark:bg-amber-600 hover:bg-amber-600 dark:hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-accent transition hover:cursor-pointer disabled:opacity-75 disabled:cursor-not-allowed"
            >
              <svg
                id="contact-spinner"
                class="hidden animate-spin -ml-1 mr-3 h-5 w-5 text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="contact-btn-text">Enviar Mensaje</span>
            </button>
          </div>
        </form>

        <div id="contact-success" class="hidden text-center py-8 px-4">
          <div
            class="w-16 h-16 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm"
          >
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-serif text-brand-blue-dark dark:text-brand-blue-light mb-3">¡Mensaje enviado con éxito!</h3>
          <p class="text-gray-700 dark:text-gray-300 max-w-md mx-auto mb-6 leading-relaxed">
            Muchas gracias por ponerte en contacto. He recibido tu mensaje y me pondré en contacto contigo a la mayor brevedad posible.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center text-gray-800 dark:text-gray-200 animate-fade-in-up delay-200">
        <p>También puedes contactarme directamente a través de:</p>
        <p class="text-lg mt-2 font-medium text-brand-blue-dark dark:text-brand-blue-light">
          <a href={`mailto:${import.meta.env.CONTACT_EMAIL}`} class="hover:underline">{import.meta.env.CONTACT_EMAIL}</a> |
          <a href="tel:+34630893355" class="hover:underline">+34 630 893 355</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const contactForm = document.getElementById("contact-form") as HTMLFormElement;
  const contactSuccess = document.getElementById("contact-success");
  const contactError = document.getElementById("contact-error");
  const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement;
  const submitSpinner = document.getElementById("contact-spinner");
  const btnText = document.getElementById("contact-btn-text");

  contactForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (contactError) {
      contactError.classList.add("hidden");
      contactError.textContent = "";
    }

    const formData = new FormData(contactForm);
    const turnstileResponse = formData.get("cf-turnstile-response");

    if (!turnstileResponse) {
      if (contactError) {
        contactError.textContent = "Por favor, completa el Captcha de seguridad.";
        contactError.classList.remove("hidden");
      }
      return;
    }

    // Estado cargando
    if (submitBtn && submitSpinner && btnText) {
      submitBtn.disabled = true;
      submitSpinner.classList.remove("hidden");
      btnText.textContent = "Enviando...";
    }

    try {
      const response = await fetch(contactForm.action, {
        method: "POST",
        body: formData
      });

      if (response.ok) {
        contactForm.classList.add("hidden");
        contactSuccess?.classList.remove("hidden");
        contactForm.reset();
        if ("turnstile" in window) {
          (window as any).turnstile.reset();
        }
      } else {
        const result = await response.json();
        if (contactError) {
          contactError.textContent = result.error || "Hubo un error al enviar el mensaje. Inténtalo de nuevo.";
          contactError.classList.remove("hidden");
        }
      }
    } catch (error) {
      if (contactError) {
        contactError.textContent = "Error de conexión. Por favor, comprueba tu red e inténtalo de nuevo.";
        contactError.classList.remove("hidden");
      }
    } finally {
      if (submitBtn && submitSpinner && btnText) {
        submitBtn.disabled = false;
        submitSpinner.classList.add("hidden");
        btnText.textContent = "Enviar Mensaje";
      }
    }
  });
</script>
