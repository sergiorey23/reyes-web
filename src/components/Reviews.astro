---
import { sanityClient } from "sanity:client";
import Turnstile from "./Turnstile.astro";

interface Review {
  rating: number;
  title: string;
  content: string;
  name?: string;
  date?: string;
}

// Obtenemos todos los ratings para calcular las estadísticas sin cargar textos inútiles
const allRatings = await sanityClient.fetch(`*[_type == "review" && approved == true]{rating}`);

// Obtenemos las 3 primeras reseñas completas para la carga inicial
const initialReviews: Review[] = await sanityClient.fetch(`*[_type == "review" && approved == true] | order(date desc)[0...3]`);

// Helper to render stars
const renderStars = (rating: number) => {
  return Array.from({ length: 5 })
    .map((_, i) =>
      i < rating
        ? '<svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>'
        : '<svg class="w-5 h-5 text-gray-300 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>'
    )
    .join("");
};

// Calculations for summary
const totalReviews = allRatings.length;
const averageRatingNum = totalReviews > 0 ? allRatings.reduce((acc: number, review: { rating: number }) => acc + (review.rating || 0), 0) / totalReviews : 0;
const averageRating = averageRatingNum.toFixed(1).replace(".", ",");

const ratingCounts = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
allRatings.forEach((r: { rating: number }) => {
  const rating = r.rating || 0;
  if (rating >= 1 && rating <= 5) {
    ratingCounts[rating as keyof typeof ratingCounts]++;
  }
});

const ratingPercentages = {
  5: totalReviews > 0 ? Math.round((ratingCounts[5] / totalReviews) * 100) : 0,
  4: totalReviews > 0 ? Math.round((ratingCounts[4] / totalReviews) * 100) : 0,
  3: totalReviews > 0 ? Math.round((ratingCounts[3] / totalReviews) * 100) : 0,
  2: totalReviews > 0 ? Math.round((ratingCounts[2] / totalReviews) * 100) : 0,
  1: totalReviews > 0 ? Math.round((ratingCounts[1] / totalReviews) * 100) : 0
};

const labels: Record<number, string> = {
  5: "Excelente",
  4: "Muy buena",
  3: "Media",
  2: "Mala",
  1: "Muy mala"
};
---

<section class="py-16 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-serif text-brand-green-dark dark:text-brand-green-light text-center mb-12">Lo que dicen mis pacientes</h2>

    <!-- Summary -->
    <div class="max-w-lg mx-auto bg-gray-50 dark:bg-gray-900 p-5 sm:p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 mb-12">
      <div class="flex items-center gap-3 mb-1">
        <span class="text-3xl font-bold text-gray-900 dark:text-gray-100">{averageRating}</span>
        <div class="flex" set:html={renderStars(Math.round(averageRatingNum))} />
      </div>
      <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm font-medium">
        {averageRating} de 5 estrellas (basado en {totalReviews} reseña{totalReviews !== 1 ? "s" : ""})
      </p>

      <div class="space-y-2">
        {
          [5, 4, 3, 2, 1].map((star) => (
            <div class="flex items-center gap-3 text-xs sm:text-sm">
              <div class="w-20 sm:w-24 shrink-0 text-gray-700  dark:text-gray-300 font-medium">{labels[star as keyof typeof labels]}</div>
              <div class="grow h-2.5 bg-gray-200 dark:bg-gray-500 rounded-sm overflow-hidden">
                <div
                  class="h-full bg-yellow-400 rounded-sm transition-all duration-1000 ease-out"
                  style={`width: ${ratingPercentages[star as keyof typeof ratingPercentages]}%`}
                />
              </div>
              <div class="w-10 sm:w-12 shrink-0 text-right text-gray-600  dark:text-gray-400 font-medium">
                {ratingPercentages[star as keyof typeof ratingPercentages]}%
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 mb-8" id="reviews-grid">
      {
        initialReviews.map((review, index) => (
          <div class="bg-gray-50 dark:bg-gray-900 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 review-card">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex items-center" set:html={renderStars(review.rating)} />
              {review.date && (
                <span class="text-sm text-gray-500 dark:text-gray-400 font-medium border-l border-gray-300 dark:border-gray-600 pl-3">
                  {new Date(review.date).toLocaleDateString("es-ES")}
                </span>
              )}
            </div>
            <h3 class="font-bold text-lg mb-2 text-gray-800 dark:text-gray-200">{review.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 italic">{review.content}</p>
            <div class="text-sm text-gray-500 dark:text-gray-400 font-medium">- {review.name || "Anónimo"}</div>
          </div>
        ))
      }
    </div>

    {
      totalReviews > 3 && (
        <div class="text-center mb-12">
          <button
            id="load-more-reviews"
            type="button"
            class="  transition duration-300 border border-brand-green dark:border-brand-green-light text-brand-green dark:text-brand-green-light font-medium py-2 px-6 rounded-md hover:bg-brand-green dark:hover:bg-brand-green-light hover:text-white dark:hover:text-black cursor-pointer"
          >
            Cargar más reseñas
          </button>
        </div>
      )
    }

    <!-- Review Form -->
    <div
      class="max-w-2xl mx-auto bg-white dark:bg-gray-900 transition-colors duration-300 p-6 lg:p-8 rounded-xl shadow-md border border-gray-100 dark:border-gray-700"
    >
      <h3 class="text-2xl font-serif mb-6 text-center">Deja tu reseña</h3>
      <form action="/api/reviews" method="POST" class="space-y-4" id="review-form">
        <div>
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" id="rating-label">Puntuación</span>
          <div class="flex space-x-1" id="star-rating" aria-labelledby="rating-label" role="radiogroup">
            <svg
              class="w-8 h-8 text-gray-300 cursor-pointer star transition-colors hover:text-yellow-400"
              data-value="1"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <svg
              class="w-8 h-8 text-gray-300 cursor-pointer star transition-colors hover:text-yellow-400"
              data-value="2"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <svg
              class="w-8 h-8 text-gray-300 cursor-pointer star transition-colors hover:text-yellow-400"
              data-value="3"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <svg
              class="w-8 h-8 text-gray-300 cursor-pointer star transition-colors hover:text-yellow-400"
              data-value="4"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <svg
              class="w-8 h-8 text-gray-300 cursor-pointer star transition-colors hover:text-yellow-400"
              data-value="5"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <input type="hidden" name="rating" id="rating-input" value="0" />
          <p id="rating-error" class="text-red-500 text-sm mt-1 hidden">Por favor, selecciona una puntuación.</p>
        </div>

        <div>
          <label for="review-title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Título</label>
          <input
            id="review-title"
            type="text"
            name="title"
            required
            class="w-full bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-2 border focus:ring-brand-blue focus:border-brand-blue"
          />
        </div>

        <div>
          <label for="review-content" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Reseña</label>
          <textarea
            id="review-content"
            name="content"
            rows="4"
            required
            class="w-full bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-2 border focus:ring-brand-blue focus:border-brand-blue"
          ></textarea>
        </div>

        <div>
          <label for="review-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nombre (Opcional)</label>
          <input
            id="review-name"
            type="text"
            name="name"
            autocomplete="name"
            class="w-full bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 rounded-md shadow-sm p-2 border focus:ring-brand-blue focus:border-brand-blue"
          />
        </div>

        <Turnstile />

        <div id="review-general-error" class="hidden p-3 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-300"></div>

        <button
          type="submit"
          id="review-submit-btn"
          class="w-full flex items-center justify-center bg-amber-500 dark:bg-amber-600 hover:bg-amber-600 dark:hover:bg-amber-700 text-white font-medium py-3 px-4 rounded-md cursor-pointer transition disabled:opacity-75 disabled:cursor-not-allowed"
        >
          <svg id="review-spinner" class="hidden animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span id="review-btn-text">Enviar reseña</span>
        </button>
      </form>

      <div id="review-success" class="hidden text-center py-8 px-4">
        <div class="w-14 h-14 bg-amber-100 dark:bg-amber-900/30 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-serif text-gray-800 dark:text-gray-100 mb-2">¡Muchísimas gracias por tu opinión!</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed max-w-md mx-auto" id="review-success-msg">
          Tu reseña ha sido enviada y registrada correctamente. Agradezco sinceramente tu tiempo y valoración.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Script para gestionar la carga de más reseñas
  const loadMoreBtn = document.getElementById("load-more-reviews") as HTMLButtonElement | null;
  if (loadMoreBtn) {
    let currentPage = 0;
    const limit = 3;
    const reviewsGrid = document.getElementById("reviews-grid");

    const renderStars = (rating: number) => {
      return Array.from({ length: 5 })
        .map((_, i) =>
          i < rating
            ? '<svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>'
            : '<svg class="w-5 h-5 text-gray-300 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>'
        )
        .join("");
    };

    loadMoreBtn.addEventListener("click", async () => {
      const originalText = loadMoreBtn.innerText;
      loadMoreBtn.innerText = "Cargando...";
      loadMoreBtn.disabled = true;
      loadMoreBtn.classList.add("opacity-75", "cursor-not-allowed");

      try {
        currentPage++;
        const res = await fetch(`/api/get-reviews?page=${currentPage}`);
        const newReviews = await res.json();

        newReviews.forEach((review: any) => {
          const card = document.createElement("div");
          card.className = "bg-gray-50 dark:bg-gray-900 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 review-card";

          const dateStr = review.date ? new Date(review.date).toLocaleDateString("es-ES") : "";
          const dateHtml = review.date
            ? `<span class="text-sm text-gray-500 dark:text-gray-400 font-medium border-l border-gray-300 dark:border-gray-600 pl-3">${dateStr}</span>`
            : "";

          card.innerHTML = `
            <div class="flex items-center gap-3 mb-4">
              <div class="flex items-center">${renderStars(review.rating)}</div>
              ${dateHtml}
            </div>
            <h3 class="font-bold text-lg mb-2 text-gray-800 dark:text-gray-200">${review.title || ""}</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 italic">${review.content || ""}</p>
            <div class="text-sm text-gray-500 dark:text-gray-400 font-medium">- ${review.name || "Anónimo"}</div>
          `;

          reviewsGrid?.appendChild(card);
        });

        if (newReviews.length < limit) {
          loadMoreBtn.style.display = "none";
        }
      } catch (err) {
        console.error(err);
      } finally {
        loadMoreBtn.innerText = originalText;
        loadMoreBtn.disabled = false;
        loadMoreBtn.classList.remove("opacity-75", "cursor-not-allowed");
      }
    });
  }

  // Script para gestionar las estrellas interactivas
  const stars = document.querySelectorAll(".star");
  const ratingInput = document.getElementById("rating-input") as HTMLInputElement;
  const ratingError = document.getElementById("rating-error");
  const reviewGeneralError = document.getElementById("review-general-error");
  const form = document.getElementById("review-form") as HTMLFormElement;
  const reviewSuccess = document.getElementById("review-success");
  const reviewSuccessMsg = document.getElementById("review-success-msg");
  const reviewSubmitBtn = document.getElementById("review-submit-btn") as HTMLButtonElement;
  const reviewSpinner = document.getElementById("review-spinner");
  const reviewBtnText = document.getElementById("review-btn-text");

  stars.forEach((star) => {
    star.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      const value = parseInt(target.getAttribute("data-value") || "0", 10);
      ratingInput.value = value.toString();
      ratingError?.classList.add("hidden");

      stars.forEach((s) => {
        const starValue = parseInt(s.getAttribute("data-value") || "0", 10);
        if (starValue <= value) {
          s.classList.remove("text-gray-300");
          s.classList.add("text-yellow-400");
        } else {
          s.classList.add("text-gray-300");
          s.classList.remove("text-yellow-400");
        }
      });
    });

    star.addEventListener("mouseover", (e) => {
      const target = e.currentTarget as HTMLElement;
      const value = parseInt(target.getAttribute("data-value") || "0", 10);
      stars.forEach((s) => {
        const starValue = parseInt(s.getAttribute("data-value") || "0", 10);
        if (starValue <= value) {
          s.classList.add("text-yellow-300");
        } else {
          s.classList.remove("text-yellow-300");
        }
      });
    });

    star.addEventListener("mouseout", () => {
      stars.forEach((s) => s.classList.remove("text-yellow-300"));
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (reviewGeneralError) {
      reviewGeneralError.classList.add("hidden");
      reviewGeneralError.textContent = "";
    }

    if (ratingInput.value === "0") {
      ratingError?.classList.remove("hidden");
      return;
    }

    const formData = new FormData(form);
    const turnstileResponse = formData.get("cf-turnstile-response");

    if (!turnstileResponse) {
      if (reviewGeneralError) {
        reviewGeneralError.textContent = "Por favor, completa el Captcha de seguridad.";
        reviewGeneralError.classList.remove("hidden");
      }
      return;
    }

    if (reviewSubmitBtn && reviewSpinner && reviewBtnText) {
      reviewSubmitBtn.disabled = true;
      reviewSpinner.classList.remove("hidden");
      reviewBtnText.textContent = "Enviando...";
    }

    try {
      const response = await fetch("/api/reviews", {
        method: "POST",
        body: formData
      });

      if (response.ok) {
        const isFiveStars = ratingInput.value === "5";
        if (reviewSuccessMsg) {
          reviewSuccessMsg.textContent = isFiveStars
            ? "¡Tu reseña se ha publicado automáticamente! Agradezco mucho tu valoración de 5 estrellas."
            : "Tu reseña ha sido registrada y está pendiente de moderación. ¡Gracias por compartir tu experiencia!";
        }
        form.classList.add("hidden");
        reviewSuccess?.classList.remove("hidden");
        form.reset();
        ratingInput.value = "0";
      } else {
        const result = await response.json();
        if (reviewGeneralError) {
          reviewGeneralError.textContent = result.error || "Hubo un error al enviar la reseña. Inténtalo de nuevo.";
          reviewGeneralError.classList.remove("hidden");
        }
      }
    } catch (error) {
      if (reviewGeneralError) {
        reviewGeneralError.textContent = "Error de conexión. Inténtalo de nuevo.";
        reviewGeneralError.classList.remove("hidden");
      }
    } finally {
      if (reviewSubmitBtn && reviewSpinner && reviewBtnText) {
        reviewSubmitBtn.disabled = false;
        reviewSpinner.classList.add("hidden");
        reviewBtnText.textContent = "Enviar reseña";
      }
    }
  });
</script>
